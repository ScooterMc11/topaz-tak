/target
# Alternate cargo target dirs used for side-by-side builds (--target-dir).
/target-*
*.csv
*.svg
perf.*
.env
src/*.bin
*.bin
*.book
*.exe

# Local research artifacts, training data, and runtime logs (kept out of the repo)
/4x4/
/5x5/
/6x6/
results.html
*.log

# Bot manager web app: deps, builds, the local (plaintext-password) config, and saved game logs
bot-manager-app/**/node_modules/
bot-manager-app/**/dist/
bot-manager-app/bot-manager-config.json
bot-manager-app/game-logs/
# Fallback location for the game database when D: isn't available (see server/src/db/paths.ts).
bot-manager-app/data/
# Loose saved game logs contain a real bot-account password in a debug config dump - keep out.
bot-manager-app/*-game.json